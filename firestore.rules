rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@mlc.local";
    }

    function validResult() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          "uid", "name", "score", "total", "time",
          "submittedAt", "autoSubmitted"
        ])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10
        && request.resource.data.total == 10
        && request.resource.data.time is int
        && request.resource.data.time >= 0
        && request.resource.data.time <= 300
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 32;
    }

    match /examResults/{resultId} {
      // A signed-in student browser may create its own result document.
      // The document UID must match the authenticated UID.
      allow create: if request.auth != null && validResult();

      // Only the Firebase Admin account can view/edit/delete past results.
      allow read, update, delete: if isAdmin();
    }
  }
}
