rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /examResults/{resultId} {
      // Students do not get direct Firestore access from the browser.
      // The production build should write results through a trusted backend
      // or use a carefully designed authenticated submission flow.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "admin@mlc.local";
    }
  }
}
